{
  "name": "dailyincrementalgame",
  "private": true,
  "type": "module",
  "description": "Dev tooling only. The site itself is static files in public/ with no build step.",
  "scripts": {
    "serve": "python3 -m http.server -d public 8080",
    "check": "node tests/check.mjs",
    "og": "node tools/og.mjs",
    "fonts": "node tools/fonts.mjs",
    "setup": "playwright install chromium",
    "vendor": "node tools/vendor.mjs",
    "art": "node tools/art.mjs",
    "credits": "node tools/credits.mjs",
    "samples": "node tools/samples.mjs",
    "mix": "node tools/mix.mjs",
    "music": "python3 tools/slopwave.py",
    "music:setup": "python3 .agents/skills/slopwave/scripts/setup.py --project . --install --ref 6253c8a73ca6767d1f1280717f1057c3a534f972",
    "music:check": "node tests/music.mjs",
    "music:game-check": "node tests/game-music.mjs",
    "music:push": "python3 tools/music_storage.py push",
    "music:pull": "python3 tools/music_storage.py pull",
    "music:status": "python3 tools/music_storage.py status",
    "music:verify": "python3 tools/music_storage.py verify",
    "music:storage-check": "python3 tests/music_storage.py"
  },
  "devDependencies": {
    "@ffmpeg-installer/ffmpeg": "^1.1.0",
    "@strudel/soundfonts": "^1.3.0",
    "@strudel/web": "^1.3.0",
    "break_infinity.js": "^2.2.0",
    "esbuild": "^0.28.2",
    "matter-js": "^0.20.0",
    "perfect-freehand": "^1.2.3",
    "pixi-filters": "^6.1.5",
    "pixi.js": "^8.22.0",
    "playwright": "^1.64.1",
    "roughjs": "^4.6.6",
    "wrangler": "4.152.0",
    "zzfx": "^1.4.0"
  }
}
